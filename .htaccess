# CodeIgniter 4 — document root (XAMPP subfolder or production domain root)

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 300M
    php_value post_max_size 310M
    php_value memory_limit 512M
    php_value max_execution_time 1800
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 300M
    php_value post_max_size 310M
    php_value memory_limit 512M
    php_value max_execution_time 1800
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes +FollowSymLinks
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteBase is auto-detected from the folder URL (e.g. /cscs/ or /public_html/).
    # Production domain root: no RewriteBase needed when index.php is at document root.

    RewriteRule ^\.well-known/ - [L]

    # Static files in public/
    RewriteRule ^css/(.*)$ public/css/$1 [L]
    RewriteRule ^js/(.*)$ public/js/$1 [L]
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
    RewriteCond %{DOCUMENT_ROOT}/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ uploads/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^(LPHS2\.png|poster2\.png|robots\.txt|citizens\.png|citizens2\.png)$ public/$1 [L]

    # Do not rewrite existing files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send everything else to CodeIgniter ( ?/  helps on some Windows Apache builds )
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

# Security Headers (production hardening)
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS filter in browsers (legacy support)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HSTS (only if HTTPS is enabled - uncomment when HTTPS is configured)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Permissions Policy (restrict browser features)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Cache static assets for 1 year
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Compress text-based assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Block access to sensitive files
<FilesMatch "\.(env|sql|log|md|lock|gitignore|htaccess)$">
    Require all denied
</FilesMatch>
<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
