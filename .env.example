# ---------------------------------------------------------------------------
# CSCS Tap n Track — environment template
#
# Copy this file to `.env` at the project root and fill in real values.
# `.env` is git-ignored; this template is committed so a fresh clone knows
# exactly which variables the application expects.
#
#   copy .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
CI_ENVIRONMENT = development
app.baseURL = http://localhost:8080/
app.forceGlobalSecureRequests = false

# --- Database (MySQL / MariaDB) -------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = cscs_sms
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# --- Outbound email --------------------------------------------------------
# Supabase project used as the primary transactional-email transport
# (app/Libraries/SupabaseEmailService.php). Leave blank to skip.
SUPABASE_ANON_KEY =

# Gmail app password used as the SMTP fallback by the same service.
GMAIL_APP_PASSWORD =

# --- Database backups (optional) -------------------------------------------
# Every value below has a safe default; no credential is ever configured here.
# The dump/restore clients reuse the database.* connection above and receive the
# password through their process environment (never on the command line).
#
# Rolling maximum of stored backups (the oldest are removed first).
backup.retentionCount = 30
# Absolute paths to the mysql/mysqldump clients when they are not on PATH
# (shared hosting often keeps them outside the web user's PATH).
backup.mysqldumpPath =
backup.mysqlPath =
# Directory that stores the dumps. Defaults to writable/backups and must stay
# OUTSIDE the web root.
backup.backupDir =
# Fallback defaults for the automatic backup schedule: frequency, time and
# enable/pause are configured by a master admin on
# Administration → Database backups (stored in `system_settings`). These two keys
# apply only until a schedule has been saved there.
backup.enabled = true
# Default hour (server time) the plan runs from — prefills the admin page.
backup.scheduleHour = 2
